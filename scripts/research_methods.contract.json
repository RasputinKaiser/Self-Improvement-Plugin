        },
        "fired_rules": [],
        "inconsistent": [],
        "boundary": "Conditional support under supplied assumptions; reference presence is not source verification. Recompute after retraction; contradictions do not entail unrelated claims."
      }
    },
    {
      "id": "infeasible",
      "args": [
        "coverage",
        "--request-file",
        "input.json"
