      "id": "unseeded-cycle",
      "args": [
        "assumptions",
        "--request-file",
        "input.json"
      ],
      "fixtures": {
        "input.json": "{\"facts\": {}, \"rules\": [{\"id\": \"loop\", \"premises\": {\"a\": true}, \"conclusion\": \"a\", \"value\": true}]}"
      },
      "json": {
        "schema": "sips.method-receipt.v1",
        "method": "assumptions",
        "input_identity": "0bb81cfd566b76097d332d9940e91076f61071ca079a78cd47385d3640c3c562",
